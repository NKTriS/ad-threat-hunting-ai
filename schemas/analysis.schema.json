{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Incident Analysis",
  "type": "object",
  "required": ["incident_id", "technique", "mitre_id", "classification", "risk", "confidence", "evidence", "explanation_vi", "recommendations_vi", "sources", "limitations_vi"],
  "properties": {
    "incident_id": { "type": "string" },
    "technique": { "type": "string" },
    "mitre_id": { "type": "string" },
    "classification": { "enum": ["true_positive", "false_positive", "needs_review"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "explanation_vi": { "type": "string" },
    "recommendations_vi": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "limitations_vi": { "type": "array", "items": { "type": "string" } },
    "rag_context": { "type": "object" }
  },
  "additionalProperties": false
}
